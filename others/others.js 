// Charts section dots
const chartsScroll = document.querySelector('.charts-scroll');
const chartDots = document.querySelectorAll('#chartDots .dot');

chartsScroll.addEventListener('scroll', () => {
  const idx = Math.round(chartsScroll.scrollLeft / chartsScroll.clientWidth);
  chartDots.forEach((d, i) => d.classList.toggle('active', i === idx));
});

chartDots.forEach((d, i) => {
  d.addEventListener('click', () => {
    chartsScroll.scrollTo({ left: i * chartsScroll.clientWidth, behavior: 'smooth' });
  });
});

